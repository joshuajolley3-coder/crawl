##############################################################################
# ancient_temple.des: The Ancient Temple, a one-level branch off Lair:2-4 that
# only some games have.
#
# A sweltering jungle, a river with a single ford, and a stepped pyramid whose
# terraces wind up to the last altar of Tonalli, the Burning Heart. The maps
# are generated by a script that guarantees every floor cell is reachable.
#
# Glyphs:
#   {  arrival (becomes the stair back to the Lair)
#   t  jungle tree            W/w  shallow / deep water
#   c  temple wall (vine-grown brick)   ,  temple floor (sandstone)
#   G  sun-stone pillar       X  the altar of Tonalli
#   1  jungle beast           2  something in the river
#   J  jaguar warrior         P  sun priest        F  feathered serpent
#   *  good loot   |  superb loot   R  a rare elixir   M  a ritual mask
##############################################################################

{{
function ancient_temple_setup(e)
  e.tags("no_monster_gen no_item_gen no_pool_fixup")
  e.orient("encompass")
  e.place("Ruin")
  e.kfeat("X = altar_tonalli")
  e.kfeat(", = floor")
  e.ftile(", = floor_sandstone")
  e.rtile("c = wall_brick_vines")
  e.kmons("1 = black mamba / jumping spider / wolf spider w:6 / " ..
          "vampire mosquito / spark wasp w:5")
  e.kmons("2 = anaconda / alligator w:5")
  e.kmons("J = jaguar warrior")
  e.kmons("P = sun priest")
  e.kmons("F = feathered serpent")
  e.kitem("R = potion of titan's blood / potion of quicksilver / " ..
          "potion of sagacity / potion of vitality / potion of arcana / " ..
          "potion of experience w:5")
  e.kitem("M = mask")
end
}}

default-depth: Ruin
NAME:   ancient_temple_pyramid
